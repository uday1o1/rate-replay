RATEREPLAY_ENV=development
RATEREPLAY_DATABASE_URL=postgresql+psycopg://ratereplay:ratereplay@postgres:5432/ratereplay
RATEREPLAY_ALLOWED_ORIGIN=https://localhost:5173
RATEREPLAY_POSTGRES_PORT=55432
RATEREPLAY_OBJECT_STORE_ROOT=/var/lib/ratereplay/objects
RATEREPLAY_OBJECT_STORE_BACKEND=s3
RATEREPLAY_S3_ENDPOINT=object-store:9000
RATEREPLAY_S3_BUCKET=ratereplay-private
RATEREPLAY_S3_ACCESS_KEY_FILE=/run/secrets/minio_user
RATEREPLAY_S3_SECRET_KEY_FILE=/run/secrets/minio_password
# Local Compose uses HTTP; staging and production require true.
RATEREPLAY_S3_SECURE=false
RATEREPLAY_OBJECT_ENCRYPTION_KEYS_DIR=/run/secrets/object-encryption-keys
RATEREPLAY_OBJECT_ENCRYPTION_CURRENT_KEY_VERSION=object-key-v1
RATEREPLAY_SESSION_SECRET_FILE=/run/secrets/session_secret
RATEREPLAY_DELETION_LEDGER_KEY_FILE=/run/secrets/deletion_ledger_key
