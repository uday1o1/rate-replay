RATEREPLAY_ENV=development
RATEREPLAY_DATABASE_URL=postgresql+psycopg://ratereplay:ratereplay@postgres:5432/ratereplay
RATEREPLAY_ALLOWED_ORIGIN=https://localhost:5173
RATEREPLAY_POSTGRES_PORT=55432
RATEREPLAY_OBJECT_STORE_ROOT=/var/lib/ratereplay/objects
RATEREPLAY_SESSION_SECRET_FILE=/run/secrets/session_secret
RATEREPLAY_LEDGER_KEY_FILE=/run/secrets/deletion_ledger_key
