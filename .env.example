RATEREPLAY_ENV=development
RATEREPLAY_DATABASE_URL=postgresql+psycopg://ratereplay:ratereplay@postgres:5432/ratereplay
RATEREPLAY_DATABASE_AT_REST_ENCRYPTION=development-unencrypted
RATEREPLAY_ALLOWED_ORIGIN=https://localhost:5173
# Set only to the exact internal proxy networks that overwrite forwarding headers.
RATEREPLAY_TRUSTED_PROXY_CIDRS=
# Use console only when the deployment log sink is approved for sanitized traces.
RATEREPLAY_TRACE_EXPORTER=none
RATEREPLAY_POSTGRES_PORT=55432
RATEREPLAY_OBJECT_STORE_ROOT=/var/lib/ratereplay/objects
RATEREPLAY_OBJECT_STORE_BACKEND=s3
RATEREPLAY_S3_ENDPOINT=object-store:9000
RATEREPLAY_S3_BUCKET=ratereplay-private
RATEREPLAY_S3_ACCESS_KEY_FILE=/run/secrets/minio_user
RATEREPLAY_S3_SECRET_KEY_FILE=/run/secrets/minio_password
# Local Compose uses HTTP; staging and production require true.
RATEREPLAY_S3_SECURE=false
RATEREPLAY_OBJECT_ENCRYPTION_KEYS_DIR=/run/secrets/object-encryption-keys
RATEREPLAY_OBJECT_ENCRYPTION_CURRENT_KEY_VERSION=object-key-v1
RATEREPLAY_BACKUP_OBJECT_STORE_BACKEND=s3
RATEREPLAY_BACKUP_S3_ENDPOINT=backup-store:9000
RATEREPLAY_BACKUP_S3_BUCKET=ratereplay-backups
RATEREPLAY_BACKUP_S3_ACCESS_KEY_FILE=/run/secrets/backup_minio_user
RATEREPLAY_BACKUP_S3_SECRET_KEY_FILE=/run/secrets/backup_minio_password
# Local Compose uses HTTP; staging and production require true.
RATEREPLAY_BACKUP_S3_SECURE=false
RATEREPLAY_BACKUP_OBJECT_ENCRYPTION_KEYS_DIR=/run/secrets/backup-encryption-keys
RATEREPLAY_BACKUP_OBJECT_ENCRYPTION_CURRENT_KEY_VERSION=backup-key-v1
RATEREPLAY_BACKUP_PGDUMP_COMMAND_JSON=["pg_dump"]
RATEREPLAY_BACKUP_PGDUMP_VERSION_COMMAND_JSON=["pg_dump"]
RATEREPLAY_BACKUP_PGRESTORE_COMMAND_JSON=["pg_restore"]
RATEREPLAY_BACKUP_PGHOST=postgres
RATEREPLAY_BACKUP_PGPORT=5432
RATEREPLAY_BACKUP_PGDATABASE=ratereplay
RATEREPLAY_BACKUP_PGUSER=ratereplay
RATEREPLAY_BACKUP_PGPASSFILE=/run/secrets/postgres_pgpass
RATEREPLAY_SESSION_SECRET_FILE=/run/secrets/session_secret
RATEREPLAY_DELETION_LEDGER_KEYS_DIR=/run/secrets/deletion_ledger_keys
RATEREPLAY_DELETION_LEDGER_CURRENT_KEY_VERSION=ledger-v1
RATEREPLAY_RESTORE_KEYS_DIR=/run/secrets/restore_keys
RATEREPLAY_RESTORE_CURRENT_KEY_VERSION=restore-v1
RATEREPLAY_TRANSACTION_OUTCOME_KEY_FILE=/run/secrets/transaction_outcome_key
# Every version-named key file must contain exactly 32 raw bytes or 64 hex characters.
# Runtime refuses a plaintext v1 ledger and requires an explicit offline migration.
