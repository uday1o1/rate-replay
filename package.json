{
  "name": "rate-replay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "build": "corepack pnpm --filter @ratereplay/web build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "corepack pnpm --filter @ratereplay/web test",
    "test:e2e": "corepack pnpm --filter @ratereplay/web test:e2e",
    "typecheck": "corepack pnpm --filter @ratereplay/web typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "globals": "17.3.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
